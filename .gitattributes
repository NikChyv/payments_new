# Shell-скрипты запускаются в Git Bash и на Linux-раннере: CRLF ломает bash
# (ошибка «\r: command not found»). Восстановление файлов (scripts/restore_files.sh)
# запускают как раз с Windows — в аварию, когда разбираться некогда.
*.sh text eol=lf

# Шрифты — бинарные. При core.autocrlf=true git угадывает сам, но угаданный
# «текст» в сжатом woff2 — это испорченный файл у всех клиентов сразу.
*.woff2 binary
